# DXN Store Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=5000
NODE_ENV=development
# Public base URL of the site (used for generated upload URLs).
BASE_URL=http://localhost:5000

# Database
# Required in production (the app refuses to connect without it when
# NODE_ENV=production). On Vercel use the Mongo Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/dxn_store

# JWT — must be >= 32 chars in production (the app refuses to start otherwise).
JWT_SECRET=dxn_store_development_change_in_production
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:3000

# Telegram (order notifications) — optional; safe no-op when unset.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Admin seed (used by seed scripts only; public /register always creates staff)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_me_immediately

# File Upload — images only (magic-byte validated server-side).
# NOTE: Vercel functions cap request bodies at ~4.5 MB; keep MAX_FILE_SIZE
# at or below 4.5 MB (4500000) when deploying there.
MAX_FILE_SIZE=5242880  # 5MB (local/Docker)
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp

# Trust one reverse-proxy hop so per-IP rate limits and logs see real client
# IPs (X-Forwarded-For). Auto-enabled on Vercel (VERCEL=1); set it manually
# (e.g. 1) when running behind nginx/Caddy. Leave unset for direct local runs.
# TRUST_PROXY=1

# External image storage (REQUIRED in production — the Vercel/Docker filesystem
# is ephemeral). local is for development only; production refuses local unless
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true with a persistent mounted volume.
STORAGE_PROVIDER=local            # local | cloudinary
# Cloudinary (production recommended):
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true   # only with a persistent volume

# AI
# Provider used by the orchestrator: openai | anthropic | deterministic
# "deterministic" needs no key and answers from retrieved data only (safe,
# no LLM). Choose openai or anthropic in production and set the matching key below.
AI_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
STORE_URL_BASE=https://dxn.dz/product

# Meta (Instagram / Facebook) — Phase 19N-P
# These are REQUIRED to go live. Setup is external (developer account, app,
# page connection, review) and cannot be completed in code.
META_VERIFY_TOKEN=your_meta_verify_token_here
META_APP_SECRET=your_meta_app_secret_here
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_GRAPH_VERSION=v19.0

# Shipping
DEFAULT_SHIPPING_HOME=0
DEFAULT_SHIPPING_OFFICE=0