{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/build",
  "functions": {
    "api/index.js": {
      "includeFiles": ["dist/frontend/build/**", "dist/backend/**", "dist/Database/**"],
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}